            api.addHeader('Content-Type: application/x-www-form-urlencoded');
            api.addHeader('Cookie: ' + cookies.join('; '));
            // Step 1: Refresh bitrates/processing for the processing node
            var enc = encodeURIComponent(procNode);
            api.get(url + '/bitrates/processing/refresh?s_xID=' + enc + '&s_type=');
            // Step 2: Fetch processing bitrate rows
            var resp = api.post(url + '/bitrates/processing/get_rows?s_xID=' + enc + '&s_type=',
                'table_id=bitrates_processing_table&paging_info_bitrates_processing_table=' +
                encodeURIComponent('{"start_row":0,"rows_to_show":500}'));
            if (!resp) throw new Error('Empty response from /bitrates/processing/get_rows for ' + procNode);
            var marker = "tbl_data_bitrates_processing_table='";
            var idx = resp.indexOf(marker);
            if (idx < 0) throw new Error('No tbl_data marker in /bitrates/processing response. Check {$VDCM.PROC.NODE}: ' + procNode);
            var start = idx + marker.length;
            var end = resp.indexOf("';", start);
            if (end < 0) throw new Error('No closing marker in /bitrates/processing response.');
            var raw = resp.substring(start, end)
                .replace(/&quot;/g, '"').replace(/&amp;/g, '&')
                .replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>');
            var rows = JSON.parse(raw);
            // FTV: all rows are service-level (no " @ " profile sub-rows)
            // Collect all rows with a non-empty name and cur > 0
            var services = [];
            var proc_bps = 0;
            rows.forEach(function(row) {
                var v    = row.values || [];
                var name = String(v[2] || '').trim();
                var cur  = parseFloat(String(v[3] || '').trim()) || 0;
                if (!name || cur <= 0) return;
                var bps = Math.round(cur * 1000000);
                services.push({ name: name, bps: bps });
                proc_bps += bps;
            });
            if (services.length === 0)
                throw new Error('No service rows from /bitrates/processing for ' + procNode + '. Check {$VDCM.PROC.NODE}.');
            return JSON.stringify({ proc_bps: proc_bps, services: services });
          description: >-
            Logs into vDCM and queries /bitrates/processing for the processing node ({$VDCM.PROC.NODE} = T_T:2:*:*:e0).
            FTV returns 4 service-level rows directly (EBC/TVBS/FTV/EBCF, no profile sub-rows).
            Returns: {"proc_bps":39600000,"services":[{"name":"EBC","bps":9841000},...]}.
            Normal total ~39.6 Mbps (EBC+TVBS+FTV+EBCF each ~9.8-9.9 Mbps).
          timeout: 30s
        - uuid: c3db63d91ef04c4fafe741ecacaeb47d
          name: 'vDCM total processing bitrate'
          type: DEPENDENT
          key: vdcm.proc.bitrate
          delay: '0'
          history: 90d
          units: bps
          description: 'Total output bitrate across all encoding services from /bitrates/processing (EBC+TVBS+FTV+EBCF). Normal ~39.6 Mbps.'
          preprocessing:
            - type: JSONPATH
              parameters:
                - $.proc_bps
          master_item:
            key: vdcm.services.bitrates
          triggers:
            - uuid: df2b9a9517304702b4a1dc7b3426b9aa
              expression: >-
                min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.proc.bitrate,2m)=0
                and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.proc.bitrate,5m)=0
                and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
              name: 'vDCM: all encoding stopped (total output = 0 bps)'
              priority: DISASTER
              description: 'Total processing bitrate has been 0 bps for 2+ minutes while device is Active. All services have stopped encoding.'
            - uuid: 5a13e819d4864f8db6719835b2ac8f4e
              expression: >-
                min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.proc.bitrate,3m)<{$VIDEO.PROC.BITRATE.WARN}
                and min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.proc.bitrate,3m)>0
              name: 'vDCM: total output bitrate dropped below threshold ({ITEM.LASTVALUE})'
              priority: HIGH
              description: >-
                Total processing bitrate dropped below {$VIDEO.PROC.BITRATE.WARN} bps for 3+ minutes.
                Normal total is ~39.6 Mbps. Threshold {$VIDEO.PROC.BITRATE.WARN} = 30 Mbps (~75%).
        - uuid: 60fb670da1204cbd9b06e8e8dc8e3e7e
          name: 'vDCM active encoding service count'
          type: DEPENDENT
          key: vdcm.services.count
          delay: '0'
          history: 90d
          description: 'Number of encoding services actively returning bitrate from /bitrates/processing. Expected: 4 (EBC/TVBS/FTV/EBCF).'
          preprocessing:
            - type: JAVASCRIPT
              parameters:
                - |
                  var obj = JSON.parse(value);
                  var svcs = obj.services || obj;
                  return String(svcs.length);
          master_item:
            key: vdcm.services.bitrates
          triggers:
            - uuid: 7129a172b32344008d56e6345149aef1
              expression: >-
                min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.services.count,3m)<{$VDCM.SVC.COUNT.MIN}
                and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.services.count,5m)=0
                and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
              name: 'vDCM: fewer encoding services than expected ({ITEM.LASTVALUE}<{$VDCM.SVC.COUNT.MIN})'
              priority: DISASTER
              description: 'Number of active encoding services below {$VDCM.SVC.COUNT.MIN} for 3+ minutes. Expected: EBC, TVBS, FTV, EBCF.'
        - uuid: 3a4b5c6d7e8f4819a93a4b5c6d7e8f90
          name: 'vDCM SDI input signal status'
          type: SCRIPT
          key: vdcm.sdi.status
          delay: 2m
          history: 1h
          value_type: TEXT
          params: |
            var url      = '{$VDCM.URL}'.replace(/\/+$/, '');
            var user     = '{$VDCM.USER}';
            var pass     = '{$VDCM.PASS}';
            var sdiNodes = '{$VDCM.SDI.NODES}'.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
            if (!url || url.indexOf('http') !== 0)
                throw new Error('Invalid {$VDCM.URL}: "' + url + '"');
            if (sdiNodes.length === 0) return JSON.stringify([]);
            var login = new HttpRequest();
            try { login.setopt(64, 0); login.setopt(81, 0); } catch(e) {}
            login.addHeader('Content-Type: application/x-www-form-urlencoded');
            login.post(url + '/login_handler?came_from=%2F',
                'login=' + encodeURIComponent(user) + '&password=' + encodeURIComponent(pass) + '&login_button=Login');
            var loginCode = login.getStatus();
            var cookies = [];
            try {
                var hdrs = login.getHeaders(false);
                if (hdrs && typeof hdrs === 'object' && !Array.isArray(hdrs)) {
                    Object.keys(hdrs).forEach(function(k) {
                        if (k.toLowerCase() === 'set-cookie') {
                            var v = hdrs[k];
                            (Array.isArray(v) ? v : [v]).forEach(function(c) {
                                var p = c.split(';')[0].trim(); if (p) cookies.push(p);
                            });
                        }
                    });
                }
            } catch(e) {}
            if (cookies.length === 0) {
                try {
                    var rawHdr = login.getHeaders(true);
                    if (typeof rawHdr !== 'string') rawHdr = String(rawHdr);
                    (rawHdr.match(/Set-Cookie:\s*([^\r\n]+)/ig) || []).forEach(function(m) {
                        var p = m.replace(/^Set-Cookie:\s*/i, '').split(';')[0].trim();
                        if (p) cookies.push(p);
                    });
                } catch(e) {}
            }
            if (cookies.length === 0)
                throw new Error('Login failed (HTTP ' + loginCode + '). Check {$VDCM.URL}/{$VDCM.USER}/{$VDCM.PASS}.');
            var api = new HttpRequest();
            try { api.setopt(64, 0); api.setopt(81, 0); } catch(e) {}
            api.addHeader('Content-Type: application/x-www-form-urlencoded');
            api.addHeader('Cookie: ' + cookies.join('; '));
            var result = [];
            sdiNodes.forEach(function(xid, idx) {
                var resp = api.post(url + '/service/overview/opennode2',
                    'xID=' + encodeURIComponent(xid) + '&type=');
                var signal = 0;
                var svcName = '';
                try {
                    var children = JSON.parse(resp);
                    if (children.length > 0) {
                        var ctx = children[0].context || '';
                        signal = (ctx.indexOf('_129d') !== -1 || ctx.indexOf('_128d') !== -1) ? 1 : 0;
                        var title = children[0].title || '';
                        svcName = title.split(/[\s(]/)[0];
                    }
                } catch(e) {}
                result.push({ name: 'SDI' + (idx + 1), port: xid, service: svcName, signal: signal });
            });
            return JSON.stringify(result);
          description: >-
            Queries each SDI stream node via opennode2 to detect signal presence.
            Returns JSON: [{"name":"SDI1","port":"T_I:2:0:*:512","service":"EBC","signal":1},...]
            signal=1 = SDI input active (_128d flag on this device; _129d on SPORTCAST — both are checked).
            signal=0 = no signal or no service assigned.
            SDI nodes from macro {$VDCM.SDI.NODES}. Set macro to empty to disable.
            LiTV_FTV_SRT: SDI1=EBC, SDI2=TVBS, SDI3=FTV, SDI4=EBCF.
          timeout: 30s
        - uuid: 6df3406c2cd84a89b3b690bb1652c9a6
          name: 'vDCM SRT output stream bitrates (HTTP API)'
          type: SCRIPT
          key: vdcm.srt.output
          delay: 2m
          history: 1h
          value_type: TEXT
          params: |
            var url     = '{$VDCM.URL}'.replace(/\/+$/, '');
            var user    = '{$VDCM.USER}';
            var pass    = '{$VDCM.PASS}';
            var outCard = '{$VDCM.OUTPUT.CARD}';
            if (!url || url.indexOf('http') !== 0)
                throw new Error('Invalid {$VDCM.URL}: "' + url + '"');
            var login = new HttpRequest();
            try { login.setopt(64, 0); } catch(e) {}
            try { login.setopt(81, 0); } catch(e) {}
            try { login.setopt(52, 0); } catch(e) {}
            login.addHeader('Content-Type: application/x-www-form-urlencoded');
            login.post(url + '/login_handler?came_from=%2F',
                'login=' + encodeURIComponent(user) + '&password=' + encodeURIComponent(pass) + '&login_button=Login');
            var loginCode = login.getStatus();
            var cookies = [];
            try {
                var hdrs = login.getHeaders(false);
                if (hdrs && typeof hdrs === 'object' && !Array.isArray(hdrs)) {
                    Object.keys(hdrs).forEach(function(k) {
                        if (k.toLowerCase() === 'set-cookie') {
                            var v = hdrs[k];
                            (Array.isArray(v) ? v : [v]).forEach(function(c) {
                                var p = c.split(';')[0].trim(); if (p) cookies.push(p);
                            });
                        }
                    });
                }
            } catch(e) {}
            if (cookies.length === 0) {
                try {
                    var raw = login.getHeaders(true);
                    if (typeof raw !== 'string') raw = String(raw);
                    (raw.match(/Set-Cookie:\s*([^\r\n]+)/ig) || []).forEach(function(m) {
                        var p = m.replace(/^Set-Cookie:\s*/i, '').split(';')[0].trim();
                        if (p) cookies.push(p);
                    });
                } catch(e) {}
            }
            if (cookies.length === 0)
                throw new Error('Login failed (HTTP ' + loginCode + '). Check {$VDCM.URL}/{$VDCM.USER}/{$VDCM.PASS}.');
            var api = new HttpRequest();
            try { api.setopt(64, 0); } catch(e) {}
            try { api.setopt(81, 0); } catch(e) {}
            api.addHeader('Content-Type: application/x-www-form-urlencoded');
            api.addHeader('Cookie: ' + cookies.join('; '));
            var enc = encodeURIComponent(outCard);
            api.get(url + '/bitrates/output/refresh?s_xID=' + enc);
            var resp = api.post(url + '/bitrates/output/get_rows?s_xID=' + enc,
                'table_id=bitrates_serv_output_table&paging_info_bitrates_serv_output_table=' +
                encodeURIComponent('{"start_row":0,"rows_to_show":500}'));
            if (!resp) throw new Error('Empty response from /bitrates/output/get_rows for ' + outCard);
            var marker = "tbl_data_bitrates_serv_output_table='";
            var idx = resp.indexOf(marker);
            if (idx < 0) return JSON.stringify({ count: 0, streams: [] });
            var start = idx + marker.length;
            var end = resp.indexOf("';", start);
            if (end < 0) throw new Error('No closing marker in /bitrates/output response.');
            var rawData = resp.substring(start, end)
                .replace(/&quot;/g, '"').replace(/&amp;/g, '&')
                .replace(/&#39;/g, "'").replace(/&lt;/g, '<').replace(/&gt;/g, '>');
            var rows = JSON.parse(rawData);
            // Column layout (T_O:1:2 with s_xID filter): [5]=port, [10]=service, [11]=cur(Mbps)
            var streams = [];
            rows.forEach(function(row) {
                var v    = row.values || [];
                var svc  = String(v[10] || '').trim();
                var port = parseInt(String(v[5]  || '0').trim(), 10);
                var cur  = parseFloat(String(v[11] || '0').trim()) || 0;
                var bps  = Math.round(cur * 1000000);
                if (svc && port > 0) streams.push({ svc: svc, port: port, bps: bps, on: 0, caller: '' });
            });
            // Step 2: Get SRT caller connection state via opennode2
            var connResp = api.post(url + '/service/overview/opennode2',
                'xID=' + encodeURIComponent(outCard) + '&type=');
            var portState = {};
            try {
                var children = JSON.parse(connResp);
                children.forEach(function(ch) {
                    if (ch.nodetype !== 'TS_S') return;
                    var t = (ch.title || '').replace(/<[^>]+>/g, '');
                    var portM = t.match(/\(:(\d+)\)/);
                    if (!portM) return;
                    var p = parseInt(portM[1], 10);
                    var isOn = /\bON\b/.test(t);
                    var callerM = t.match(/Caller\s+([\d.]+)/);
                    portState[p] = { on: isOn ? 1 : 0, caller: callerM ? callerM[1] : '' };
                });
            } catch(e) {}
            // Merge connection state into streams
            var connected = 0;
            streams.forEach(function(s) {
                var state = portState[s.port] || { on: 0, caller: '' };
                s.on = state.on;
                s.caller = state.caller;
                connected += state.on;
            });
            return JSON.stringify({ count: streams.length, connected: connected, streams: streams });
          description: >-
            Queries /bitrates/output for {$VDCM.OUTPUT.CARD} (T_O:1:2 = Port 3 Mgmt).
            Also calls opennode2 for T_O:1:2 to detect SRT caller connection state from stream title (ON/OFF + Caller IP).
            Returns: {"count":8,"connected":8,"streams":[{"svc":"EBC","port":26000,"bps":9836000,"on":1,"caller":"218.211.161.8"},...]}
            Normal: 8 SRT streams active (EBC/TVBS/FTV/EBCF × 2 destinations), all on=1.
            Column layout: [5]=dest_port, [10]=service_name, [11]=cur_bitrate_Mbps.
            Master item for vdcm.srt.count, vdcm.srt.connected, and vdcm.srt.discovery LLD.
          timeout: 30s
        - uuid: 5e6483d849b34dd5884f81b919e87656
          name: 'vDCM SRT output stream count'
          type: DEPENDENT
          key: vdcm.srt.count
          delay: '0'
          history: 90d
          description: >-
            Number of active SRT output streams on Port 3 Mgmt (T_O:1:2).
            Expected: {$VDCM.SRT.COUNT.MIN} = 8 (EBC×2 + TVBS×2 + FTV×2 + EBCF×2 to both 218.211.161.8 and 211.21.3.210).
          preprocessing:
            - type: JSONPATH
              parameters:
                - $.count
          master_item:
            key: vdcm.srt.output
          triggers:
            - uuid: f24b9d0d8256470f853e1d9431126492
              expression: >-
                last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.count)<{$VDCM.SRT.COUNT.MIN}
                and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.count,5m)=0
                and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
              name: 'vDCM: SRT stream count dropped ({ITEM.LASTVALUE} < {$VDCM.SRT.COUNT.MIN})'
              priority: HIGH
              description: >-
                SRT output stream count in bitrate table dropped below {$VDCM.SRT.COUNT.MIN}.
                This indicates a stream was removed from vDCM configuration or the bitrate table
                is not returning all rows. (For caller disconnection, see vdcm.srt.connected trigger.)
                Check Output > I/O 1 > Port 3 Mgmt at {$VDCM.URL}.
        - uuid: 444b263389404f039ff040aef631707f
          name: 'vDCM SRT connected stream count'
          type: DEPENDENT
          key: vdcm.srt.connected
          delay: '0'
          history: 90d
          description: >-
            Number of SRT streams with an active caller connection (ON=true + Caller IP present).
            Expected: {$VDCM.SRT.COUNT.MIN} = 8. Detects SRT caller disconnection immediately
            at next 2-minute poll, before bitrate drops to zero.
            Source: opennode2 stream title contains "ON" keyword and "Caller" IP.
          preprocessing:
            - type: JAVASCRIPT
              parameters:
                - |
                  var obj = JSON.parse(value);
                  var n = 0;
                  (obj.streams || []).forEach(function(s) { if (s.on === 1) n++; });
                  return String(n);
          master_item:
            key: vdcm.srt.output
          triggers:
            - uuid: 8f23f24820e74dff942b6e2c39d33fe1
              expression: >-
                last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.connected)<{$VDCM.SRT.COUNT.MIN}
                and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.connected,5m)=0
                and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
              name: 'vDCM: SRT caller disconnected ({ITEM.LASTVALUE}/{$VDCM.SRT.COUNT.MIN} streams connected)'
              priority: DISASTER
              description: >-
                One or more SRT output streams lost their caller connection (ON flag missing or no Caller IP).
                Stream title changes from "[SRT] EBC (1) ON ID:1 ... (Caller ...)" to "OFF" or loses Caller info.
                Expected {$VDCM.SRT.COUNT.MIN} connected callers (218.211.161.8 + 211.21.3.210 × 4 services).
                Content delivery is interrupted. Check Output > I/O 1 > Port 3 Mgmt at {$VDCM.URL}.
      discovery_rules:
        - uuid: a1b2c3d4e5f6481987a1b2c3d4e5f697
          name: 'vDCM service bitrate discovery'
          type: DEPENDENT
          key: vdcm.service.discovery
          delay: '0'
          lifetime: 7d
          description: >-
            Discovers encoding services from vdcm.services.bitrates JSON.
            Creates per-service bitrate item and three triggers automatically.
            Services are auto-detected: no template changes needed when channels change.
          master_item:
            key: vdcm.services.bitrates
          preprocessing:
            - type: JAVASCRIPT
              parameters:
                - |
                  var obj = JSON.parse(value);
                  var data = obj.services || obj;
                  return JSON.stringify(data.map(function(s) {
                      return { '{#SERVICE.NAME}': s.name, '{#SERVICE.TITLE}': s.name };
                  }));
          item_prototypes:
            - uuid: b2c3d4e5f6a7481988b2c3d4e5f6a798
              name: '{#SERVICE.NAME} - bitrate'
              type: DEPENDENT
              key: 'vdcm.bitrate[{#SERVICE.NAME}]'
              delay: '0'
              history: 90d
              units: bps
              description: 'Encoding service {#SERVICE.NAME} current output bitrate in bps.'
              master_item:
                key: vdcm.services.bitrates
              preprocessing:
                - type: JAVASCRIPT
                  parameters:
                    - |
                      var obj = JSON.parse(value);
                      var data = obj.services || obj;
                      var name = '{#SERVICE.NAME}';
                      for (var i = 0; i < data.length; i++) {
                          if (data[i].name === name) { return String(data[i].bps); }
                      }
                      return '0'; // service absent from response = treat as crashed (bps=0)
              trigger_prototypes:
                - uuid: c3d4e5f6a7b8481989c3d4e5f6a7b8a9
                  expression: >-
                    min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.bitrate[{#SERVICE.NAME}],3m)<{$VIDEO.BITRATE.MIN}
                    and min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.bitrate[{#SERVICE.NAME}],3m)>0
                    and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
                  name: '{#SERVICE.NAME}: bitrate below minimum ({ITEM.LASTVALUE})'
                  priority: HIGH
                  description: 'Service {#SERVICE.NAME} bitrate critically below {$VIDEO.BITRATE.MIN} bps for 3+ minutes.'
                - uuid: d4e5f6a7b8c9481980d4e5f6a7b8c9b0
                  expression: >-
                    min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.bitrate[{#SERVICE.NAME}],3m)<{$VIDEO.BITRATE.WARN}
                    and min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.bitrate[{#SERVICE.NAME}],3m)>{$VIDEO.BITRATE.MIN}
                    and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
                  name: '{#SERVICE.NAME}: bitrate is low ({ITEM.LASTVALUE})'
                  priority: AVERAGE
                  description: 'Service {#SERVICE.NAME} bitrate below warning threshold {$VIDEO.BITRATE.WARN} bps for 3+ minutes.'
                - uuid: e5f6a7b8c9d0481981e5f6a7b8c9d0c1
                  expression: >-
                    min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.bitrate[{#SERVICE.NAME}],2m)=0
                    and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.bitrate[{#SERVICE.NAME}],5m)=0
                    and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
                  name: '{#SERVICE.NAME}: stream stopped (bitrate = 0)'
                  priority: DISASTER
                  description: 'Service {#SERVICE.NAME} bitrate has been 0 bps for 2+ minutes while vDCM is Active. Confirmed encoding outage. Note: with 2-min polling, min(2m)=0 fires on the first 0 reading — detection is immediate. Check at {$VDCM.URL} → Processing → {#SERVICE.NAME}.'
                - uuid: eae68c25bdbe4079ad7bc78c6cc76f4f
                  expression: >-
                    nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.bitrate[{#SERVICE.NAME}],5m)=1
                    and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
                  name: '{#SERVICE.NAME}: service missing (no data)'
                  priority: DISASTER
                  description: 'Service {#SERVICE.NAME} has not returned data for 5+ minutes while vDCM is Active. Service may be removed or crashed.'
        - uuid: 4b5c6d7e8f9a4819b44b5c6d7e8f9ab5
          name: 'vDCM SDI input signal discovery'
          type: DEPENDENT
          key: vdcm.sdi.discovery
          delay: '0'
          lifetime: 7d
          description: >-
            Discovers SDI input ports from vdcm.sdi.status.
            Creates one signal item and trigger per SDI port.
            LiTV_FTV_SRT: SDI1(EBC), SDI2(TVBS), SDI3(FTV), SDI4(EBCF).
          master_item:
            key: vdcm.sdi.status
          preprocessing:
            - type: JAVASCRIPT
              parameters:
                - |
                  var arr = JSON.parse(value);
                  return JSON.stringify(arr.map(function(s) {
                      return { '{#SDINAME}': s.name, '{#SDIPORT}': s.port, '{#SDISVC}': s.service };
                  }));
          item_prototypes:
            - uuid: 4d32ca8ac414442aa90c5e7f151960cd
              name: '{#SDINAME} ({#SDISVC}) - signal'
              type: DEPENDENT
              key: 'vdcm.sdi.signal[{#SDINAME}]'
              history: 90d
              description: 'SDI input signal status: 1=present, 0=lost. {#SDINAME} maps to service {#SDISVC} at port {#SDIPORT}.'
              master_item:
                key: vdcm.sdi.status
              preprocessing:
                - type: JAVASCRIPT
                  parameters:
                    - |
                      var arr = JSON.parse(value);
                      var name = '{#SDINAME}';
                      for (var i = 0; i < arr.length; i++) {
                          if (arr[i].name === name) { return String(arr[i].signal); }
                      }
                      throw new Error(name + ' not found in vdcm.sdi.status response');
              trigger_prototypes:
                - uuid: aa71effcdb79405da3fed0e7e3bb690e
                  expression: >-
                    min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.sdi.signal[{#SDINAME}],3m)=0
                    and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.sdi.signal[{#SDINAME}],5m)=0
                    and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
                  name: '{#SDINAME} ({#SDISVC}): SDI input signal lost'
                  priority: HIGH
                  description: >-
                    SDI input {#SDINAME} for service {#SDISVC} has had no signal for 3+ minutes while vDCM is Active.
                    Check SDI cable and source equipment at {$VDCM.URL}.
        - uuid: 7464b40c32c945b7a85fa500fc55163a
          name: 'vDCM SRT output stream discovery'
          type: DEPENDENT
          key: vdcm.srt.discovery
          delay: '0'
          lifetime: 7d
          description: >-
            Discovers SRT output streams from vdcm.srt.output.
            Creates per-stream: connection state (on/off) + bitrate items with triggers.
            LiTV_FTV_SRT: 8 streams — EBC/TVBS/FTV/EBCF × ports 26000-26007 (2 destinations each).
            {#SRT.SVC}=service name, {#SRT.PORT}=listen port, {#SRT.DEST}=caller/destination IP.
          master_item:
            key: vdcm.srt.output
          preprocessing:
            - type: JAVASCRIPT
              parameters:
                - |
                  var obj = JSON.parse(value);
                  return JSON.stringify((obj.streams || []).map(function(s) {
                      return {
                          '{#SRT.SVC}':  s.svc,
                          '{#SRT.PORT}': String(s.port),
                          '{#SRT.DEST}': s.caller || ''
                      };
                  }));
          item_prototypes:
            - uuid: 21fe473d029c4ca9a645e2649f38af98
              name: '{#SRT.SVC} (:{#SRT.PORT} → {#SRT.DEST}) - SRT caller connected'
              type: DEPENDENT
              key: 'vdcm.srt.on[{#SRT.PORT}]'
              history: 90d
              description: >-
                SRT caller connection state for service {#SRT.SVC} port :{#SRT.PORT}.
                1 = caller {#SRT.DEST} is connected (ON in stream title).
                0 = no caller connected (OFF or title missing Caller).
                Detects disconnection at next 2-min poll — before bitrate drops to zero.
              master_item:
                key: vdcm.srt.output
              preprocessing:
                - type: JAVASCRIPT
                  parameters:
                    - |
                      var obj = JSON.parse(value);
                      var port = parseInt('{#SRT.PORT}', 10);
                      var streams = obj.streams || [];
                      for (var i = 0; i < streams.length; i++) {
                          if (streams[i].port === port) return String(streams[i].on);
                      }
                      return '0';
              trigger_prototypes:
                - uuid: 44328071d1ae4a0eb39bfb474d064da6
                  expression: >-
                    last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.on[{#SRT.PORT}])=0
                    and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.on[{#SRT.PORT}],5m)=0
                    and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
                  name: '{#SRT.SVC} (:{#SRT.PORT} → {#SRT.DEST}): SRT caller disconnected'
                  priority: DISASTER
                  description: >-
                    SRT caller for {#SRT.SVC} on port :{#SRT.PORT} (remote: {#SRT.DEST}) is not connected.
                    The stream title changed from "ON ... (Caller {#SRT.DEST})" — content delivery to this destination has stopped.
                    Check SRT caller at {#SRT.DEST} and network path to {$VDCM.URL} > Output > Port 3 Mgmt.
            - uuid: 24dca817ac22407bb292e8c9f55418ed
              name: '{#SRT.SVC} (:{#SRT.PORT} → {#SRT.DEST}) - SRT output bitrate'
              type: DEPENDENT
              key: 'vdcm.srt.bitrate[{#SRT.PORT}]'
              history: 90d
              units: bps
              description: 'SRT output bitrate for service {#SRT.SVC} on port :{#SRT.PORT} to {#SRT.DEST}. Source: {$VDCM.OUTPUT.CARD}.'
              master_item:
                key: vdcm.srt.output
              preprocessing:
                - type: JAVASCRIPT
                  parameters:
                    - |
                      var obj = JSON.parse(value);
                      var port = parseInt('{#SRT.PORT}', 10);
                      var streams = obj.streams || [];
                      for (var i = 0; i < streams.length; i++) {
                          if (streams[i].port === port) return String(streams[i].bps);
                      }
                      throw new Error('{#SRT.PORT} not found in vdcm.srt.output');
              trigger_prototypes:
                - uuid: 463f625a94d74a80b93155969c970cc3
                  expression: >-
                    min(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.bitrate[{#SRT.PORT}],3m)=0
                    and nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.srt.bitrate[{#SRT.PORT}],5m)=0
                    and last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.vdcm_state)="Active"
                  name: '{#SRT.SVC} (:{#SRT.PORT} → {#SRT.DEST}): SRT output bitrate zero'
                  priority: AVERAGE
                  description: >-
                    SRT output bitrate for {#SRT.SVC} on port :{#SRT.PORT} (to {#SRT.DEST}) has been 0 bps for 3+ minutes.
                    Secondary indicator — if caller is still connected (vdcm.srt.on=1), this may indicate an encoding fault rather than network disconnection.
                    Primary disconnection alarm: "{#SRT.SVC} (:{#SRT.PORT} → {#SRT.DEST}): SRT caller disconnected" (DISASTER).
                    Check at {$VDCM.URL} > Output > I/O 1 > Port 3 Mgmt.
      macros:
        - macro: '{$VDCM.URL}'
          value: 'https://61.220.40.194:4431'
          description: 'vDCM web UI base URL, no trailing slash.'
        - macro: '{$VDCM.USER}'
          value: Administrator
          description: 'vDCM web login username'
        - macro: '{$VDCM.PASS}'
          value: ''
          type: SECRET_TEXT
          description: 'vDCM web login password. Set per-host as Secret macro.'
        - macro: '{$VDCM.INPUT.CARDS}'
          value: 'T_I:2:0,T_I:2:1,T_I:2:2,T_I:2:3'
          description: >-
            Input card xIDs for processing alarm checks.
            T_I:2:0~T_I:2:3 = Board 2 (vMFP 2), Kona4_1 SDI1-SDI4.
            These are the four SDI input ports for EBC/TVBS/FTV/EBCF.
            Note: T_I:2:4 does NOT exist on this device (verified 2026-06-11).
        - macro: '{$VDCM.SDI.NODES}'
          value: 'T_I:2:0:*:512,T_I:2:1:*:513,T_I:2:2:*:514,T_I:2:3:*:515'
          description: >-
            Comma-separated SDI stream xID nodes for signal monitoring.
            SDI1=T_I:2:0:*:512(EBC), SDI2=T_I:2:1:*:513(TVBS),
            SDI3=T_I:2:2:*:514(FTV), SDI4=T_I:2:3:*:515(EBCF).
            Verified 2026-06-11 on LiTV_FTV_SRT (61.220.40.194:4431).
            Set empty string to disable SDI monitoring.
        - macro: '{$VDCM.OUTPUT.CARD}'
          value: 'T_O:1:2'
          description: >-
            Output node xID for Port 3 Mgmt (I/O 1, Board 1).
            T_O:1:2 = Port 3 Mgmt on I/O 1 (0-indexed: Port1=:0, Port3=:2, Port5=:4).
            Verified 2026-06: contains 8 SRT streams (EBC/TVBS/FTV/EBCF x2 destinations).
        - macro: '{$VDCM.PROC.NODE}'
          value: 'T_T:2:*:*:e0'
          description: >-
            Processing node xID for /bitrates/processing queries.
            T_T:2:*:*:e0 = vMFP 2 processing summary node.
            Verified 2026-06: returns 4 service rows (EBC/TVBS/FTV/EBCF) with cur ~9.8-9.9 Mbps each.
        - macro: '{$VDCM.SVC.COUNT.MIN}'
          value: '4'
          description: 'Minimum expected number of encoding services. DISASTER trigger fires if fewer. EBC/TVBS/FTV/EBCF = 4.'
        - macro: '{$VDCM.SRT.COUNT.MIN}'
          value: '8'
          description: >-
            Minimum expected number of active SRT output streams on Port 3 Mgmt (T_O:1:2).
            EBC/TVBS/FTV/EBCF × 2 destinations (218.211.161.8 + 211.21.3.210) = 8 total streams.
            DISASTER trigger fires if active stream count falls below this value.
        - macro: '{$VIDEO.PROC.BITRATE.WARN}'
          value: '30000000'
          description: >-
            Warning threshold for total processing bitrate in bps. Default 30,000,000 bps (30 Mbps = ~75% of 39.6 Mbps nominal).
            Fires HIGH alert when total output drops significantly (one or more services degraded).
        - macro: '{$VIDEO.BITRATE.WARN}'
          value: '8000000'
          description: >-
            Warning threshold in bps. Default 8,000,000 bps (8 Mbps = 80% of 10 Mbps nominal).
            EBC/EBCF/FTV/TVBS normal range: 9.6-10.3 Mbps.
        - macro: '{$VIDEO.BITRATE.MIN}'
          value: '5000000'
          description: >-
            Critical threshold in bps. Default 5,000,000 bps (5 Mbps = 50% of 10 Mbps nominal).
            Trigger fires when encoding is severely degraded but not stopped.
