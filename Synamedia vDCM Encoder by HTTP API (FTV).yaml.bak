        - uuid: 846dacb4e32547038a7290ab5000ba9f
          name: 'vDCM device health status'
          type: SCRIPT
          key: vdcm.device.status
          delay: 2m
          history: 1h
          value_type: TEXT
          params: |
            var url = '{$VDCM.URL}'.replace(/\/+$/, '');
            var user = '{$VDCM.USER}';
            var pass = '{$VDCM.PASS}';
            if (!url || url.indexOf('http') !== 0)
                throw new Error('Invalid {$VDCM.URL}: "' + url + '"');
            var login = new HttpRequest();
            try { login.setopt(64, 0); } catch(e) {}
            try { login.setopt(81, 0); } catch(e) {}
            try { login.setopt(52, 0); } catch(e) {}
            login.addHeader('Content-Type: application/x-www-form-urlencoded');
            login.post(url + '/login_handler?came_from=%2F',
                'login=' + encodeURIComponent(user) + '&password=' + encodeURIComponent(pass) + '&login_button=Login');
            var loginCode = login.getStatus();
            var cookies = [];
            try {
                var hdrs = login.getHeaders(false);
                if (hdrs && typeof hdrs === 'object' && !Array.isArray(hdrs)) {
                    Object.keys(hdrs).forEach(function(k) {
                        if (k.toLowerCase() === 'set-cookie') {
                            var v = hdrs[k];
                            (Array.isArray(v) ? v : [v]).forEach(function(c) {
                                var p = c.split(';')[0].trim(); if (p) cookies.push(p);
                            });
                        }
                    });
                }
            } catch(e) {}
            if (cookies.length === 0) {
                try {
                    var raw = login.getHeaders(true);
                    if (typeof raw !== 'string') raw = String(raw);
                    (raw.match(/Set-Cookie:\s*([^\r\n]+)/ig) || []).forEach(function(m) {
                        var p = m.replace(/^Set-Cookie:\s*/i, '').split(';')[0].trim();
                        if (p) cookies.push(p);
                    });
                } catch(e) {}
            }
            if (cookies.length === 0)
                throw new Error('Login failed (HTTP ' + loginCode + '). Check {$VDCM.URL}/{$VDCM.USER}/{$VDCM.PASS}.');
            var api = new HttpRequest();
            try { api.setopt(64, 0); } catch(e) {}
            try { api.setopt(81, 0); } catch(e) {}
            api.addHeader('Cookie: ' + cookies.join('; '));
            var response = api.get(url + '/load_alarm_footer');
            if (!response) throw new Error('vDCM /load_alarm_footer returned empty response.');
            var alarmMatch = response.match(/device_status'\)\.textContent\s*=\s*'([^']*)'/);
            var stateMatch = response.match(/device_state'\)\.textContent\s*=\s*'([^']*)'/);
            var vdcmMatch  = response.match(/vdcm_state'\)\.textContent\s*=\s*'([^']*)'/);
            return JSON.stringify({
                alarm_count:  alarmMatch ? parseInt(alarmMatch[1], 10) : -1,
                device_state: stateMatch ? stateMatch[1] : 'unknown',
                vdcm_state:   vdcmMatch  ? vdcmMatch[1]  : 'unknown'
            });
          description: >-
            Logs into vDCM (61.220.40.194) and queries /load_alarm_footer.
            Returns JSON: {"alarm_count":0,"device_state":"Active - Role: Standalone","vdcm_state":"Active"}.
          timeout: 30s
          triggers:
            - uuid: f43635bfa2eb4e81b5b664e4082cfd65
              expression: 'nodata(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.device.status,6m)=1'
              name: 'vDCM: device unreachable (no data for 6 min)'
              priority: HIGH
              description: 'vDCM at 61.220.40.194:4431 has not returned data for 6+ minutes (3 consecutive poll failures). Check network and vDCM service.'
        - uuid: eb7f88d83d1e4f47945178ee7153be7e
          name: 'vDCM state'
          type: DEPENDENT
          key: vdcm.device.vdcm_state
          history: 90d
          value_type: TEXT
          description: 'vDCM operational state string (e.g. "Active"). Sourced from /load_alarm_footer vdcm_state element.'
          preprocessing:
            - type: JSONPATH
              parameters:
                - $.vdcm_state
          master_item:
            key: vdcm.device.status
