          triggers:
          - uuid: 8b9c0d1e2f3a4819b88b9c0d1e2f3a48
            expression: 'last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.alarms.detail)<>"OK"'
            name: 'vDCM: unexpected alarm — {ITEM.LASTVALUE}'
            priority: HIGH
            description: >-
              Non-background alarm detected on the FTV vDCM (61.220.40.194).
              Details: {ITEM.LASTVALUE}
              Background noise (always present, excluded): PTS Discontinuity, UDP/TS Stream Loss.
              Check at https://61.220.40.194:4431 → Status > Summary.
        - uuid: 7c8d9e0f1a2b4819a77c8d9e0f1a2b48
          name: vDCM processing alarms (HTTP API)
          type: SCRIPT
          key: vdcm.processing.alarms
          delay: 1m
          history: 90d
          trends: '0'
          value_type: TEXT
          timeout: 30s
          description: >-
            Queries /status/processing/get_rows for Board 2 (vMFP 2, xID T_I:2:4)
            where SDI inputs (Kona4 SDI1-SDI4) are processed for EBC/EBCF/FTV/TVBS.
            Returns "OK" when no processing alarms.
            Returns channel name + alarm type, e.g. "EBC: TS Sync Loss" when faults exist.
          params: |
            var url   = '{$VDCM.URL}'.replace(/\/+$/, '');
            var user  = '{$VDCM.USER}';
            var pass  = '{$VDCM.PASS}';
            var cards = '{$VDCM.INPUT.CARDS}'.split(',').map(function(s){ return s.trim(); }).filter(Boolean);
            if (!url || url.indexOf('http') !== 0) throw new Error('Invalid {$VDCM.URL}: "' + url + '"');
            var login = new HttpRequest();
            try { login.setopt(64, 0); } catch(e) {}
            try { login.setopt(81, 0); } catch(e) {}
            try { login.setopt(52, 0); } catch(e) {}
            login.addHeader('Content-Type: application/x-www-form-urlencoded');
            login.post(url + '/login_handler?came_from=%2F',
                'login=' + encodeURIComponent(user) + '&password=' + encodeURIComponent(pass) + '&login_button=Login');
            var loginCode = login.getStatus();
            var cookies = [];
            try {
                var hdrs = login.getHeaders(false);
                if (hdrs && typeof hdrs === 'object' && !Array.isArray(hdrs)) {
                    Object.keys(hdrs).forEach(function(k) {
                        if (k.toLowerCase() === 'set-cookie') {
                            var v = hdrs[k];
                            (Array.isArray(v) ? v : [v]).forEach(function(c) {
                                var p = c.split(';')[0].trim(); if (p) cookies.push(p);
                            });
                        }
                    });
                }
            } catch(e) {}
            if (cookies.length === 0) {
                try {
                    var rawHdr = login.getHeaders(true);
                    if (typeof rawHdr !== 'string') rawHdr = String(rawHdr);
                    (rawHdr.match(/Set-Cookie:\s*([^\r\n]+)/ig) || []).forEach(function(m) {
                        var p = m.replace(/^Set-Cookie:\s*/i, '').split(';')[0].trim();
                        if (p) cookies.push(p);
                    });
                } catch(e) {}
            }
            if (cookies.length === 0) throw new Error('Login failed (HTTP ' + loginCode + '). Check {$VDCM.URL}/{$VDCM.USER}/{$VDCM.PASS}.');
            var cookieHdr = cookies.join('; ');
            var allAlarms = [];
            cards.forEach(function(card) {
                var api = new HttpRequest();
                try { api.setopt(64, 0); } catch(e) {}
                try { api.setopt(81, 0); } catch(e) {}
                api.addHeader('Content-Type: application/x-www-form-urlencoded');
                api.addHeader('Cookie: ' + cookieHdr);
                var resp = api.post(
                    url + '/status/processing/get_rows?s_xID=' + encodeURIComponent(card),
                    'table_id=processing_table&paging_info_processing_table=' +
                    encodeURIComponent('{"start_row":0,"rows_to_show":500}'));
                if (!resp || resp.indexOf('No Processing Alarms') >= 0) return;
                var marker = "tbl_data_processing_table='";
                var idx = resp.indexOf(marker);
                if (idx < 0) return;
                var start = idx + marker.length;
                var end = resp.indexOf("';", start);
                if (end < 0) return;
                var raw = resp.substring(start, end)
                    .replace(/&quot;/g,'"').replace(/&amp;/g,'&')
                    .replace(/&#39;/g,"'").replace(/&lt;/g,'<').replace(/&gt;/g,'>');
                var rows; try { rows = JSON.parse(raw); } catch(e) { return; }
                function stripHtml(s) { return String(s||'').replace(/<[^>]+>/g,'').trim(); }
                rows.forEach(function(row) {
                    var v = row.values || [];
                    var svc = stripHtml(v[3]);
                    var alarmType = stripHtml(v[4]);
                    if (/\(\d+x\d+/.test(svc)) return;
                    if (!svc || /^fi-/.test(svc) || /^\d+$/.test(svc)) return;
                    if (svc) allAlarms.push(alarmType ? svc+': '+alarmType : svc);
                });
            });
            if (allAlarms.length === 0) return 'OK';
            var seen = {};
            return allAlarms.filter(function(a){ if(seen[a])return false;seen[a]=true;return true; }).join(', ');
          triggers:
          - uuid: 6d7e8f9a0b1c4819866d7e8f9a0b1c48
            expression: 'last(/Synamedia vDCM Encoder by HTTP API - FTV/vdcm.processing.alarms)<>"OK"'
            name: 'vDCM: processing fault — {ITEM.LASTVALUE}'
            priority: HIGH
            description: >-
              Processing-layer fault on FTV vDCM (61.220.40.194).
              Affected channels: {ITEM.LASTVALUE}
              Source: /status/processing/get_rows for T_I:2:4 (vMFP 2 SDI inputs).
              Services: EBC / EBCF / FTV / TVBS (SDI1-SDI4 via Kona4 card).
              Investigate at https://61.220.40.194:4431 → Status > Processing.
