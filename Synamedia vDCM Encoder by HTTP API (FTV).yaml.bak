var api = new HttpRequest();
try { api.setopt(64, 0); } catch(e) {}
try { api.setopt(81, 0); } catch(e) {}
api.addHeader('Cookie: ' + cookies.join('; '));
var response = api.get(url + '/load_alarm_footer');
if (!response) throw new Error('vDCM /load_alarm_footer returned empty response.');
var alarmMatch = response.match(/device_status'\)\.textContent\s*=\s*'([^']*)'/);
var stateMatch = response.match(/device_state'\)\.textContent\s*=\s*'([^']*)'/);
var vdcmMatch  = response.match(/vdcm_state'\)\.textContent\s*=\s*'([^']*)'/);
try{var _lo=new HttpRequest();try{_lo.setopt(64,0);}catch(e){}try{_lo.setopt(81,0);}catch(e){}_lo.addHeader('Cookie: '+cookies.join('; '));_lo.get(url+'/logout');}catch(e){}
return JSON.stringify({
    alarm_count:  alarmMatch ? parseInt(alarmMatch[1], 10) : -1,
    device_state: stateMatch ? stateMatch[1] : 'unknown',
    vdcm_state:   vdcmMatch  ? vdcmMatch[1]  : 'unknown'
});
