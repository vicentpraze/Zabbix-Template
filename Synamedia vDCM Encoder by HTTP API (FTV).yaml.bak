                    if(ii<0) return [];
                    var jj=pg.indexOf("';",ii+mk.length); if(jj<0) return [];
                    try{return JSON.parse(fbDec(pg.substring(ii+mk.length,jj)));}catch(e2){return [];}
                }
                var totAlarms=0;
                ['tbl_data_tbldevicealarms','tbl_data_tblioalarms'].forEach(function(t2){
