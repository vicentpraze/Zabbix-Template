var user = '{$VDCM.USER}';
var pass = '{$VDCM.PASS}';
if (!url || url.indexOf('http') !== 0) throw new Error('Invalid {$VDCM.URL}: "' + url + '"');
var login = new HttpRequest();
try { login.setopt(64, 0); } catch(e) {}
try { login.setopt(81, 0); } catch(e) {}
try { login.setopt(52, 0); } catch(e) {}
